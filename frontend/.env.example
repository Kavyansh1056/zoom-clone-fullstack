# Frontend Environment Configuration
# Next.js Public Environment Variables

# Backend REST API URL (Render/Production or Local)
# Local: http://localhost:8000
# Production: https://<your-render-backend-name>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket Signaling Gateway URL
# Local: ws://localhost:8000
# Production: wss://<your-render-backend-name>.onrender.com
# (If omitted, the client automatically derives wss:// from NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_WS_URL=ws://localhost:8000
