# ==============================================================================
# Zoom Clone - Environment Configuration Reference
# ==============================================================================
# Copy frontend/.env.example to frontend/.env.local for Next.js development.
# Copy backend/.env.example to backend/.env for FastAPI development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Next.js - frontend/.env.local)
# ------------------------------------------------------------------------------
# Backend REST API endpoint URL
# Local: http://localhost:8000
# Production: https://<your-backend-app>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket signaling gateway endpoint URL
# Local: ws://localhost:8000
# Production: wss://<your-backend-app>.onrender.com
# (If omitted, client auto-derives wss:// from NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (FastAPI - backend/.env)
# ------------------------------------------------------------------------------
# Server port and host binding (Render automatically provides PORT in production)
PORT=8000
HOST=0.0.0.0

# Frontend URL (Configures CORS and base URL for meeting invite links)
# Local: http://localhost:3000
# Production: https://<your-frontend-app>.vercel.app
FRONTEND_URL=http://localhost:3000

# Additional Allowed CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite Database URL (per assignment requirements)
DATABASE_URL=sqlite:///./zoom_clone.db

# Meeting Invite Base Link URL
BASE_INVITE_URL=http://localhost:3000/meeting
