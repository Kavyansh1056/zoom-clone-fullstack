# Backend Environment Configuration (FastAPI)

# Server Port and Host Binding (Render dynamically assigns PORT)
PORT=8000
HOST=0.0.0.0

# Frontend URL (Used for CORS and invite link generation)
# Local: http://localhost:3000
# Production: https://<your-vercel-app-name>.vercel.app
FRONTEND_URL=http://localhost:3000

# Additional Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (SQLite required by assignment)
DATABASE_URL=sqlite:///./zoom_clone.db

# Base URL for generated meeting invite links (defaults to FRONTEND_URL/meeting if not set)
BASE_INVITE_URL=http://localhost:3000/meeting
